/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Strict-Transport-Security: max-age=31536000
  Cross-Origin-Opener-Policy: same-origin
  # CSP en vigor. Notas:
  # - blob: en script-src y connect-src: la librería importa/descarga el runtime ONNX desde blob URLs.
  # - 'unsafe-eval': @imgly/background-removal (ndarray) usa new Function().
  # - aitors-hub-dashboard.asanchezgu.workers.dev: contador de visitas del autor.
  # Si añades un recurso externo nuevo, amplía aquí la directiva correspondiente.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-eval' 'wasm-unsafe-eval' blob: https://aitors-hub-dashboard.asanchezgu.workers.dev; connect-src 'self' blob: https://aitors-hub-dashboard.asanchezgu.workers.dev; img-src 'self' data: blob: https://aitors-hub-dashboard.asanchezgu.workers.dev; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'

# Los fragmentos del modelo se nombran por contenido: cacheables de forma permanente.
/models/*
  Cache-Control: public, max-age=31536000, immutable

/models/resources.json
  ! Cache-Control
  Cache-Control: public, max-age=3600
